{
  "id": "text-to-image-video",
  "name": "文生图生视频（动态）",
  "enabled": true,
  "version": 2,
  "description": "从文字创意动态展开多个镜头，先生成关键图，再逐镜头生成视频并自动合成。",
  "category": "creation",
  "triggers": {
    "keywords": [
      "文生图生视频",
      "文生视频",
      "文字生成视频",
      "文本生成视频"
    ],
    "node_scopes": [
      "textGeneration",
      "imageGeneration",
      "videoGeneration"
    ]
  },
  "planning": {
    "planning_notes": "根据用户描述和时长动态确定镜头数；每个计划项对应一张关键图和一段视频。",
    "prompt_guide": "镜头之间保持主体、场景和视觉风格连续，单个计划项只描述一个镜头。",
    "conduct_rules": [
      "根据用户目标动态决定节点数量和依赖关系",
      "仅使用 allowed_recipe_ids 中声明的能力",
      "创建画布节点前先生成并确认动态计划"
    ]
  },
  "schema_version": "dramaclaw.workflow-skill.v1",
  "allowed_recipe_ids": [
    "general-text",
    "video-creative-outline",
    "video-storyboard-grid",
    "general-image",
    "general-video",
    "video-frame-extraction"
  ],
  "input_parameters": [],
  "evaluation": {
    "rating_bands": [
      {
        "score": 10,
        "description": "完整满足用户目标且工作流可以执行"
      },
      {
        "score": 7,
        "description": "核心流程完整，允许少量非关键调整"
      },
      {
        "score": 4,
        "description": "缺少关键阶段或依赖关系不完整"
      }
    ],
    "visual_review_items": [],
    "text_review_items": [],
    "quality_threshold": 7,
    "domain_constraints": [
      "工作流必须符合用户目标并保持输入素材一致性"
    ]
  }
}
