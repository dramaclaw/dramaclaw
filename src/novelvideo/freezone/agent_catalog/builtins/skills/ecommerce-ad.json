      "带货视频",
      "产品广告",
      "商品宣传片"
    ],
    "node_scopes": [
      "textGeneration",
      "imageGeneration",
      "videoGeneration",
      "audioGeneration"
    ]
  },
  "planning": {
    "planning_notes": "根据用户目标动态确定镜头数量；没有商品图时先生成商品锚点，有商品图时把它作为一致性参考。",
    "prompt_guide": "突出商品卖点、使用场景、品牌调性和明确行动引导，所有镜头保持商品外观一致。",
    "conduct_rules": [
      "根据用户目标动态决定节点数量和依赖关系",
      "仅使用 allowed_recipe_ids 中声明的能力",
      "创建画布节点前先生成并确认动态计划"
    ]
