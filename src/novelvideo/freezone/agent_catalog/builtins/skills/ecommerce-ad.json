{
  "id": "ecommerce-ad",
  "name": "电商广告",
  "enabled": true,
  "version": 1,
  "description": "根据商品与卖点动态规划广告镜头，生成商品锚点、广告画面、视频片段、配音并自动合成。",
  "category": "ecommerce",
  "triggers": {
