  "schema_version": "dramaclaw.workflow-skill.v1",
  "allowed_recipe_ids": [
    "general-text",
    "ecommerce-text-plan",
    "digital-product-text-plan",
    "ecommerce-style-reference",
    "video-ad-brief",
    "video-ad-creative-outline",
    "video-storyboard-script",
    "general-image",
    "ecommerce-ad-image",
    "ecommerce-scene-image",
    "ecommerce-remix-image",
    "digital-product-ad-image",
    "video-clip-generation",
    "general-audio"
  ],
  "input_parameters": [],
  "evaluation": {
    "rating_bands": [
      {
        "score": 10,
        "description": "完整满足用户目标且工作流可以执行"
      },
      {
        "score": 7,
        "description": "核心流程完整，允许少量非关键调整"
      },
      {
        "score": 4,
        "description": "缺少关键阶段或依赖关系不完整"
      }
    ],
    "visual_review_items": [],
    "text_review_items": [],
