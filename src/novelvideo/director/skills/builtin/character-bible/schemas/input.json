{
  "additionalProperties": false,
  "description": "The same character craft serves preparation and source-grounded edits.",
  "properties": {
    "schemaVersion": {
      "const": 2,
      "title": "Schemaversion",
      "type": "integer"
    },
    "stage": {
      "const": "M08",
      "title": "Stage",
      "type": "string"
    },
    "mode": {
      "enum": [
        "original",
        "adaptation"
      ],
      "title": "Mode",
      "type": "string"
    },
    "episodeOrdinal": {
      "const": 1,
      "title": "Episodeordinal",
      "type": "integer"
    },
    "totalEpisodes": {
      "maximum": 100,
      "minimum": 1,
      "title": "Totalepisodes",
      "type": "integer"
    },
    "endingType": {
      "enum": [
        "closed",
        "open",
        "reversal",
        "tragic"
      ],
      "title": "Endingtype",
      "type": "string"
    },
    "parametersHash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parametershash",
      "type": "string"
    },
    "documentKind": {
      "default": "preparation",
      "enum": [
        "preparation",
        "characters",
        "scenes",
        "props"
      ],
      "title": "Documentkind",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "mode",
    "episodeOrdinal",
    "totalEpisodes",
    "endingType",
    "parametersHash"
  ],
  "title": "CharacterMethodContext",
  "type": "object"
}
