      "type": "integer"
    },
    "stage": {
      "enum": [
        "M03",
        "M07",
        "M08",
        "M09"
      ],
      "title": "Stage",
      "type": "string"
    },
    "mode": {
      "const": "original",
      "title": "Mode",
      "type": "string"
    },
    "episodeOrdinal": {
      "const": 1,
      "title": "Episodeordinal",
      "type": "integer"
    },
    "totalEpisodes": {
      "maximum": 100,
      "minimum": 1,
      "title": "Totalepisodes",
      "type": "integer"
    },
    "endingType": {
      "enum": [
        "closed",
        "open",
        "reversal",
        "tragic"
      ],
      "title": "Endingtype",
      "type": "string"
    },
    "parametersHash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parametershash",
      "type": "string"
    }
