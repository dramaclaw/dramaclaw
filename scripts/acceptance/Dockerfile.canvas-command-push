# Disposable Linux acceptance environment; not an application/runtime image.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
RUN pip install --no-cache-dir \
    watchfiles==1.1.1 anyio==4.12.0 portalocker==3.2.0 rich==14.3.3 \
    pytest==9.0.2 pytest-asyncio==1.3.0
WORKDIR /acceptance
ENV PYTHONPATH=/source/src PYTHON_DOTENV_DISABLED=1
COPY tests/test_canvas_command_push.py /acceptance/test_canvas_command_push.py
CMD ["python", "-m", "pytest", "-o", "asyncio_mode=auto", "-q", "-s", "/acceptance"]
