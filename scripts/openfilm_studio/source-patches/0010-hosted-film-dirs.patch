+  await assert.rejects(moveToTrash(root), (e) => e.status === 409);
+  process.env.OPENFILM_TRASH_DIR = join(scratch, 'override');
+  await moveToTrash(join(root, 'notes.txt'));
+  assert.equal(existsSync(join(scratch, 'override')), false);
+});
+
+test('registration persists and recovers on load, and re-registration replaces it', async () => {
+  await open();
+  const recent = JSON.parse(readFileSync(join(scratch, 'studio/studio.json'), 'utf8')).recent[0];
