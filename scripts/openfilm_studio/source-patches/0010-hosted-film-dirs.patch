+const envKeys = ['OPENFILM_HOST_DIRS', 'OPENFILM_HOME', 'OPENFILM_LIBRARY', 'HOME', 'XDG_DATA_HOME', 'OPENFILM_TRASH_DIR'];
+let scratch, root, stateDir, runtimeDir, kept;
+beforeEach(() => {
+  kept = Object.fromEntries(envKeys.map((key) => [key, process.env[key]]));
+  scratch = realpathSync(mkdtempSync(join(tmpdir(), 'of-host-dirs-')));
+  root = join(scratch, 'film');
+  stateDir = join(scratch, 'state');
+  runtimeDir = join(scratch, 'runtime');
+  process.env.OPENFILM_HOST_DIRS = '1';
+  process.env.OPENFILM_HOME = join(scratch, 'studio');
+  process.env.OPENFILM_LIBRARY = join(scratch, 'library');
+  process.env.HOME = join(scratch, 'home');
+  process.env.XDG_DATA_HOME = join(scratch, 'xdg');
+  delete process.env.OPENFILM_TRASH_DIR;
+  clearFilmDirsForTests();
+});
+afterEach(() => {
+  clearFilmDirsForTests();
+  for (const [key, value] of Object.entries(kept)) {
+    if (value === undefined) delete process.env[key]; else process.env[key] = value;
+  }
+  rmSync(scratch, { recursive: true, force: true });
+});
+const open = () => openProject(root, { stateDir, runtimeDir });
+const film = (text = '') => `<!doctype html><html><head><meta name="viewport" content="width=1920, height=1080"></head><body><section><video src="take.mp4" at="0"></video></section><!-- ${text} --></body></html>`;
+const sha = (bytes) => createHash('sha256').update(bytes).digest('hex');
+const snapshot = (dir) => readdirSync(dir, { recursive: true, withFileTypes: true }).filter((e) => e.isFile()).map((e) => {
+  const path = join(e.parentPath, e.name);
+  return [path.slice(dir.length), readFileSync(path).toString('hex')];
+}).sort(([a], [b]) => a.localeCompare(b));
+
+test('hosted history and retained media use host state and output, including checkout, copy and export', async () => {
+  await open();
+  const media = Buffer.alloc((1 << 20) + 1, 41);
+  writeFileSync(join(root, 'film.html'), film());
+  writeFileSync(join(root, 'take.mp4'), media);
+  const v1 = await saveVersion(root);
+  assert.equal(existsSync(join(scratch, 'state/history/HEAD')), true);
+  assert.equal(existsSync(join(root, '.film/media', sha(media))), true);
+  assert.equal(existsSync(join(root, '.film/history')), false);
+  assert.equal(existsSync(join(root, '.film/cache')), false);
+  assert.equal(existsSync(join(scratch, 'runtime/cache/history-files.json')), true);
+  writeFileSync(join(root, 'film.html'), film('v2'));
+  writeFileSync(join(root, 'take.mp4'), Buffer.alloc(media.length, 42));
+  await saveVersion(root);
+  await checkoutVersion(root, v1);
+  assert.deepEqual(readFileSync(join(root, 'take.mp4')), media);
+  const into = join(scratch, 'copy');
+  mkdirSync(into);
+  await copyVersion(root, v1, into);
+  assert.deepEqual(readFileSync(join(into, 'take.mp4')), media);
+  const files = await projectFiles(root, ['history']);
+  assert.equal(files.find((f) => f.name === '.film/history/HEAD')?.file, join(scratch, 'state/history/HEAD'));
+  assert.equal(files.find((f) => f.name === `.film/history/media/${sha(media)}`)?.file, join(root, '.film/media', sha(media)));
+  assert.ok((await projectSizes(root)).history > media.length);
+});
+
+test('hosted opening requires absolute host dirs outside the film', async () => {
+  for (const [options, message] of [
+    [{}, /stateDir.*runtimeDir/],
+    [{ stateDir: 'state', runtimeDir }, /stateDir.*absolute/],
+    [{ stateDir: join(root, 'state'), runtimeDir }, /stateDir.*outside/],
+    [{ stateDir: root, runtimeDir }, /stateDir.*outside/],
+    [{ stateDir, runtimeDir: 'runtime' }, /runtimeDir.*absolute/],
+    [{ stateDir, runtimeDir: join(root, 'cache') }, /runtimeDir.*outside/],
+  ]) await assert.rejects(openProject(root, options), (e) => e.status === 400 && message.test(e.message));
+  assert.equal(existsSync(root), false, 'invalid registration writes nothing');
+});
+
+test('hosted ignores old output history without moving or changing a byte', async () => {
+  mkdirSync(root);
+  writeFileSync(join(root, 'film.html'), film());
+  const gitDir = join(root, '.film/history');
+  mkdirSync(join(root, '.film'));
+  const git = (args, input) => execFileSync('git', [`--git-dir=${gitDir}`, ...args], { cwd: root, input, env: { ...process.env, GIT_CONFIG_NOSYSTEM: '1', GIT_AUTHOR_NAME: 'test', GIT_AUTHOR_EMAIL: 'test@example.com', GIT_COMMITTER_NAME: 'test', GIT_COMMITTER_EMAIL: 'test@example.com' }, encoding: 'utf8' }).trim();
+  git(['init', '--bare', '--quiet', '--template=', '--initial-branch=main']);
+  const tree = git(['mktree'], '');
+  const commit = git(['commit-tree', tree, '-m', 'old']);
+  git(['update-ref', 'refs/heads/main', commit]);
+  const before = snapshot(gitDir);
+  await open();
+  assert.deepEqual((await log(root)).versions, []);
+  assert.deepEqual(snapshot(gitDir), before);
+  assert.deepEqual(readdirSync(join(root, '.film')).filter((name) => name.startsWith('history')), ['history']);
+});
+
+test('hosted rejects an unsupported host history without upgrading or renaming', async () => {
+  await open();
+  await saveVersion(root);
+  rmSync(join(stateDir, 'history/openfilm.json'));
+  const before = snapshot(join(stateDir, 'history'));
+  await assert.rejects(log(root), (e) => e.status === 409 && e.message === 'version history format is not supported');
+  assert.deepEqual(snapshot(join(stateDir, 'history')), before);
+  writeFileSync(join(stateDir, 'history/config'), '[include]\npath = /never-read\n');
+  await assert.rejects(log(root), (e) => e.status === 409 && e.message === 'version history format is not supported');
+});
+
+test('hosted discard keeps replaced files in output removed, never in system trash', async () => {
+  await open();
+  writeFileSync(join(root, 'notes.txt'), 'v1');
+  await saveVersion(root);
+  writeFileSync(join(root, 'notes.txt'), 'v2');
+  await discardChanges(root);
+  assert.equal(readFileSync(join(root, 'notes.txt'), 'utf8'), 'v1');
+  assert.equal(readFileSync(join(root, '.film/removed/notes.txt'), 'utf8'), 'v2');
+  writeFileSync(join(root, 'notes.txt'), 'v3');
+  await discardChanges(root);
+  assert.equal(readFileSync(join(root, '.film/removed/notes 2.txt'), 'utf8'), 'v3');
+  assert.equal(existsSync(join(process.env.HOME, '.Trash')), false);
+  assert.equal(existsSync(join(process.env.XDG_DATA_HOME, 'Trash')), false);
+  const outside = join(scratch, 'outside.txt');
