#!/bin/sh
# A single trusted preview origin may receive autoplay permission. Never accept
# arbitrary Permissions-Policy or Nginx syntax from an environment value.
CSP_OPENFILM_PREVIEW_ORIGIN=${CSP_OPENFILM_PREVIEW_ORIGIN:-}
case "$CSP_OPENFILM_PREVIEW_ORIGIN" in
    *[!A-Za-z0-9.:/-]*)
        echo >&2 'CSP_OPENFILM_PREVIEW_ORIGIN contains invalid characters'
        return 1
        ;;
esac
if ! printf '%s\n' "$CSP_OPENFILM_PREVIEW_ORIGIN" | awk '
    NF > 1 { exit 1 }
    NF == 1 {
        origin = $0
        if (origin !~ /^https:\/\//) exit 1
        sub(/^https:\/\//, "", origin)
        n = split(origin, parts, ":")
        if (n > 2) exit 1
        if (n == 2 && (parts[2] !~ /^[0-9]+$/ || parts[2] + 0 < 1 || parts[2] + 0 > 65535)) exit 1
        count = split(parts[1], host, ".")
        if (length(parts[1]) < 1 || length(parts[1]) > 253) exit 1
        for (i = 1; i <= count; i++) {
            if (length(host[i]) < 1 || length(host[i]) > 63 ||
                host[i] !~ /^[A-Za-z0-9][A-Za-z0-9-]*$/ || host[i] ~ /-$/) exit 1
        }
    }
'; then
    echo >&2 'CSP_OPENFILM_PREVIEW_ORIGIN must be one HTTPS origin without paths or wildcards'
    return 1
fi
export CSP_OPENFILM_PREVIEW_ORIGIN
