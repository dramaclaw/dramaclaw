# Copy this file to .dramaclaw-local/local.env and edit the copy.
# The destination is gitignored; never put API keys in this tracked example.

# Required when the launcher should start ComfyUI. This directory contains main.py.
COMFYUI_DIR="/absolute/path/to/ComfyUI"

# Optional when ComfyUI uses a dedicated Python environment.
# COMFYUI_PYTHON="/absolute/path/to/python"

# Set to 0 when ComfyUI is already running at COMFYUI_BASE_URL.
DRAMACLAW_START_COMFYUI=1
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_BASE_URL="http://127.0.0.1:8188"

# Optional persistent data location. When omitted, an existing ./state is reused;
# a new install uses ~/.local/share/dramaclaw-local.
# DRAMACLAW_LOCAL_DATA_DIR="/absolute/path/to/dramaclaw-data"

# Optional provider/model overrides. The SiliconFlow key belongs in
# .dramaclaw-local/secrets/siliconflow.key, not in this file.
# SILICONFLOW_TEXT_MODEL="deepseek-ai/DeepSeek-V4-Flash"
# SILICONFLOW_EMBEDDING_MODEL="BAAI/bge-m3"
# SILICONFLOW_TTS_MODEL="FunAudioLLM/CosyVoice2-0.5B"
