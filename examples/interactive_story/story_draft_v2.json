      "kind": "scene",
      "character_ids": ["spark"],
      "production_notes": "青柚绿为主色；突出冰爽、气泡和口味氛围，不使用未经证实的功效或销量宣称",
      "media": {"source": "placeholder", "status": "missing", "version": 1}
